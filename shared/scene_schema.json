{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapdaddy.local/scene_schema.json",
  "title": "Map Daddy Scene",
  "type": "object",
  "required": ["version", "project_name", "output", "sources", "shapes", "mappings", "metadata"],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.3.0"
    },
    "project_name": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["image", "video", "color", "generated"] },
          "url": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "loop": { "type": "boolean" },
          "muted": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "vertices"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["quad", "triangle", "mesh", "ellipse", "polygon"] },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/point" }
          },
          "locked": { "type": "boolean" },
          "transform": { "type": "object" },
          "mesh": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "quad" } } },
            "then": { "properties": { "vertices": { "minItems": 4, "maxItems": 4 } } }
          },
          {
            "if": { "properties": { "type": { "const": "triangle" } } },
            "then": { "properties": { "vertices": { "minItems": 3, "maxItems": 3 } } }
          }
        ]
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source_id", "input_shape_id", "output_shape_id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "source_id": { "type": "string" },
          "input_shape_id": { "type": "string" },
          "output_shape_id": { "type": "string" },
          "visible": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "solo": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blend_mode": { "enum": ["normal"] },
          "depth": { "type": "integer" }
        }
      }
    },
    "surfaces": {
      "description": "Legacy 0.2.0 compatibility input only. New saves should use mappings and shapes.",
      "type": "array"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    }
  }
}
